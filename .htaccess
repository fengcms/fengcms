RewriteEngine On
RewriteBase /

# Shared-host protection. The installer is the only public file under /install/.
RewriteRule (^|/)\. - [F,L]
RewriteRule ^(?:system|app|template|_doc|docker|tools|tests|bin|docs|var)(?:/|$) - [F,L,NC]
RewriteRule ^admin/(?:app|template)(?:/|$) - [F,L,NC]
RewriteRule ^install/(?!index\.php$) - [F,L,NC]
RewriteRule (^|/)(?:examples|swfupload)(?:/|$) - [F,L,NC]
RewriteRule ^(?:config(?:\.local)?(?:\..*)?|compose.*|LICENSE)$ - [F,L,NC]
RewriteRule ^upload/.*\.(?:php[0-9]*|phtml|phar|html?|svg|shtml|js)(?:/|$) - [F,L,NC]
RewriteRule \.(?:sql|log|ini|ya?ml|env|bak|md|conf)$ - [F,L,NC]
# Only the front controllers, captcha, installer and authenticated editor APIs run PHP.
RewriteCond %{REQUEST_URI} !^/(?:index|vccore|admin/index|admin/login|admin/api/(?:upload|files|thumbnail)|install/index)\.php$
RewriteRule \.php(?:/|$) - [F,L,NC]

RewriteRule ^index.html index.php?controller=home&operate=index

RewriteRule ^tags\.html$ index.php?controller=tags [L]

RewriteRule ^content_([A-Za-z][A-Za-z0-9_]*)_([0-9]+)\.html$ index.php?controller=content&project=$1&id=$2 [L]

RewriteRule ^tags/([^/?&=]+)_([0-9]+)\.html$ index.php?controller=search&tags=$1&page=$2 [B,L]

RewriteRule ^tags/([^/?&=]+)\.html$ index.php?controller=search&tags=$1 [B,L]

RewriteRule ^([A-Za-z][A-Za-z0-9_-]*_[0-9]+(?:_[0-9]+)?)\.html$ index.php?controller=classify&route=$1 [L]

RewriteRule ^map.html index.php?controller=map

RewriteRule ^message.html index.php?controller=message

RewriteRule ^message_add.html index.php?controller=message&operate=add

RewriteRule ^message_(.*)_(.*).html index.php?controller=message&operate=$1&id=$2

RewriteRule ^message_(.*).html index.php?controller=message&page=$1

RewriteRule ^signup.html index.php?controller=signup

RewriteRule !\.(js|txt|gif|jpg|png|bmp|css|swf|html|htm|php)$ index.php
