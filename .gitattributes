# Keep development, audit, and historical records in Git, but omit them from
# git archive packages distributed to FengCMS users.
/docs/internal/ export-ignore
/AGENTS.md export-ignore
/README.md export-ignore
/.github/ export-ignore

# Preserve the byte-for-byte upstream editor distribution and its line endings.
/admin/public/kindeditor-4.1.7/** -text -whitespace
