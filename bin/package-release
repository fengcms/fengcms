#!/bin/sh
set -eu

cd "$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
tag=${1:?Usage: ./bin/package-release vX.Y[.Z]}
if ! printf '%s' "$tag" | grep -Eq '^v[0-9]+\.[0-9]+(\.[0-9]+)?$'; then
    echo 'Release tag must be vX.Y or vX.Y.Z.' >&2
    exit 2
fi
git rev-parse -q --verify "refs/tags/$tag^{commit}" >/dev/null || {
    echo "Tag does not exist: $tag" >&2
    exit 2
}
version=$(git show "$tag:admin/version.php" | tr -d '\r\n')
if [ "$version" != "$tag" ]; then
    echo "Tag $tag does not match admin/version.php ($version)." >&2
    exit 2
fi

mkdir -p var/releases
package="var/releases/fengcms-$tag.zip"
checksum="var/releases/fengcms-$tag.sha256"
git archive --format=zip --prefix="fengcms-$tag/" --output="$package" "$tag"
python3 - "$package" "$tag" <<'PY'
import sys
import zipfile

package, tag = sys.argv[1:]
prefix = f"fengcms-{tag}/"
required_files = [
    "项目说明.md",
    "docs/README.md",
    "docs/快速开始.md",
    "docs/安装指南.md",
    "docs/后台使用指南.md",
    "docs/已有网站升级指南.md",
    "docs/配置与服务器设置.md",
    "docs/数据库备份与恢复.md",
    "docs/常见问题.md",
    "docs/第三方组件许可.md",
    f"docs/releases/{tag}-发布说明.md",
]

with zipfile.ZipFile(package) as archive:
    names = set(archive.namelist())
    forbidden = [
        name for name in names
        if name.startswith(prefix + "docs/internal/")
        or name in {prefix + "AGENTS.md", prefix + "README.md"}
        or name.startswith(prefix + ".github/")
    ]
    if forbidden:
        print("Internal maintenance files must not be included in the release archive:", file=sys.stderr)
        print("\n".join(forbidden), file=sys.stderr)
        sys.exit(1)

    missing = [prefix + name for name in required_files if prefix + name not in names]
    if missing:
        for name in missing:
            print(f"Required user documentation is missing from the release archive: {name[len(prefix):]}", file=sys.stderr)
        sys.exit(1)
PY
printf '%s  %s\n' "$(shasum -a 256 "$package" | awk '{print $1}')" "fengcms-$tag.zip" > "$checksum"
echo "Created $package and $checksum"
