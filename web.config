<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <directoryBrowse enabled="false" />
        <httpProtocol>
            <customHeaders>
                <remove name="X-Content-Type-Options" />
                <add name="X-Content-Type-Options" value="nosniff" />
                <remove name="X-Frame-Options" />
                <add name="X-Frame-Options" value="SAMEORIGIN" />
                <remove name="Referrer-Policy" />
                <add name="Referrer-Policy" value="same-origin" />
            </customHeaders>
        </httpProtocol>
        <rewrite>
            <rules>
                <!-- Block dotfiles and repository, source, runtime, and private admin directories. -->
                <rule name="FengCMS - block dotfiles" stopProcessing="true">
                    <match url="(^|/)\." />
                    <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
                </rule>
                <rule name="FengCMS - block private directories" stopProcessing="true">
                    <match url="^(system|app|template|install/(?!index\.php$)|_doc|docker|tools|tests|bin|docs|var|admin/(app|template))(/|$)" ignoreCase="true" />
                    <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
                </rule>
                <rule name="FengCMS - block legacy and private paths" stopProcessing="true">
                    <match url="^(examples|swfupload)(/|$)|^(config(\.local)?(\..*)?|compose.*|LICENSE)$" ignoreCase="true" />
                    <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
                </rule>
                <rule name="FengCMS - block private file types" stopProcessing="true">
                    <match url="\.(sql|log|ini|ya?ml|env|bak|md|conf)$" ignoreCase="true" />
                    <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
                </rule>
                <rule name="FengCMS - block executable uploads" stopProcessing="true">
                    <match url="^upload/.*\.(php[0-9]*|phtml|phar|html?|svg|shtml|js)(/|$)" ignoreCase="true" />
                    <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
                </rule>
                <!-- Permit PHP only through the front controllers and required authenticated APIs. -->
                <rule name="FengCMS - deny other PHP files" stopProcessing="true">
                    <match url=".*\.php(/|$)" ignoreCase="true" />
                    <conditions logicalGrouping="MatchAll">
                        <add input="{PATH_INFO}" pattern="^/(index|vccore|admin/index|admin/login|admin/api/(upload|files|thumbnail)|install/index)\.php$" negate="true" />
                    </conditions>
                    <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
                </rule>

                <!-- FengCMS public routes. AppendQueryString remains enabled for application parameters. -->
                <rule name="FengCMS - homepage" stopProcessing="true">
                    <match url="^index\.html$" />
                    <action type="Rewrite" url="index.php?controller=home&amp;operate=index" />
                </rule>
                <rule name="FengCMS - content" stopProcessing="true">
                    <match url="^content_([A-Za-z][A-Za-z0-9_]*)_([0-9]+)\.html$" />
                    <action type="Rewrite" url="index.php?controller=content&amp;project={R:1}&amp;id={R:2}" />
                </rule>
                <rule name="FengCMS - tags page" stopProcessing="true">
                    <match url="^tags\.html$" />
                    <action type="Rewrite" url="index.php?controller=tags" />
                </rule>
                <rule name="FengCMS - tag search page" stopProcessing="true">
                    <match url="^tags/([^/?&amp;=]+)_([0-9]+)\.html$" />
                    <action type="Rewrite" url="index.php?controller=search&amp;tags={R:1}&amp;page={R:2}" />
                </rule>
                <rule name="FengCMS - tag search" stopProcessing="true">
                    <match url="^tags/([^/?&amp;=]+)\.html$" />
                    <action type="Rewrite" url="index.php?controller=search&amp;tags={R:1}" />
                </rule>
                <rule name="FengCMS - category route" stopProcessing="true">
                    <match url="^([A-Za-z][A-Za-z0-9_-]*_[0-9]+(?:_[0-9]+)?)\.html$" />
                    <action type="Rewrite" url="index.php?controller=classify&amp;route={R:1}" />
                </rule>
                <rule name="FengCMS - sitemap" stopProcessing="true">
                    <match url="^map\.html$" />
                    <action type="Rewrite" url="index.php?controller=map" />
                </rule>
                <rule name="FengCMS - message add" stopProcessing="true">
                    <match url="^message_add\.html$" />
                    <action type="Rewrite" url="index.php?controller=message&amp;operate=add" />
                </rule>
                <rule name="FengCMS - message operation" stopProcessing="true">
                    <match url="^message_([a-z]+)_([0-9]+)\.html$" />
                    <action type="Rewrite" url="index.php?controller=message&amp;operate={R:1}&amp;id={R:2}" />
                </rule>
                <rule name="FengCMS - message page" stopProcessing="true">
                    <match url="^message_([0-9]+)\.html$" />
                    <action type="Rewrite" url="index.php?controller=message&amp;page={R:1}" />
                </rule>
                <rule name="FengCMS - message" stopProcessing="true">
                    <match url="^message\.html$" />
                    <action type="Rewrite" url="index.php?controller=message" />
                </rule>
                <rule name="FengCMS - signup" stopProcessing="true">
                    <match url="^signup\.html$" />
                    <action type="Rewrite" url="index.php?controller=signup" />
                </rule>
                <!-- Keep legacy query-based routes and real static files available. -->
                <rule name="FengCMS - front controller fallback" stopProcessing="true">
                    <match url=".*" />
                    <conditions logicalGrouping="MatchAll">
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="index.php" />
                </rule>
            </rules>
        </rewrite>
    </system.webServer>
</configuration>
